<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-google-signin"
        version="1.0.1">

  <name>Google Sign-In</name>
  <description>Google Sign-In for Cordova using modern SDKs (GoogleSignIn 7.x / play-services-auth 21.x)</description>
  <license>MIT</license>

  <engines>
    <engine name="cordova" version=">=10.0.0"/>
    <engine name="cordova-ios" version=">=6.0.0"/>
  </engines>

  <!-- Same JS namespace as cordova-plugin-googleplus for drop-in compatibility -->
  <js-module src="www/GoogleSignIn.js" name="GoogleSignIn">
    <clobbers target="window.plugins.googleplus"/>
  </js-module>

  <!-- ─── iOS ─────────────────────────────────────────────────────────── -->
  <platform name="ios">

    <!-- GoogleSignIn 7.x uses GoogleUtilities 7.8+ → compatible with firebase-messaging 6.x -->
    <podspec>
      <pods use-frameworks="true">
        <pod name="GoogleSignIn" spec="~> 7.0" />
      </pods>
    </podspec>

    <config-file target="config.xml" parent="/*">
      <feature name="GoogleSignIn">
        <param name="ios-package" value="GoogleSignInPlugin"/>
        <param name="onload" value="true"/>
      </feature>
    </config-file>

    <!-- REVERSED_CLIENT_ID URL scheme required for the OAuth redirect callback -->
    <preference name="REVERSED_CLIENT_ID"/>
    <config-file target="*-Info.plist" parent="CFBundleURLTypes">
      <array>
        <dict>
          <key>CFBundleTypeRole</key>
          <string>Editor</string>
          <key>CFBundleURLName</key>
          <string>REVERSED_CLIENT_ID</string>
          <key>CFBundleURLSchemes</key>
          <array>
            <string>$REVERSED_CLIENT_ID</string>
          </array>
        </dict>
      </array>
    </config-file>

    <header-file src="src/ios/GoogleSignInPlugin.h"/>
    <source-file src="src/ios/GoogleSignInPlugin.m"/>

  </platform>

  <!-- ─── Android ─────────────────────────────────────────────────────── -->
  <platform name="android">

    <framework src="com.google.android.gms:play-services-auth:21.3.0" />

    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="GoogleSignIn">
        <param name="android-package" value="com.junction.plugins.GoogleSignInPlugin"/>
        <param name="onload" value="true"/>
      </feature>
    </config-file>

    <source-file src="src/android/GoogleSignInPlugin.java"
                 target-dir="src/com/junction/plugins"/>

  </platform>

</plugin>
